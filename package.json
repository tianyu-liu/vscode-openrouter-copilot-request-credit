{
  "name": "openrouter-copilot-request-credit",
  "displayName": "%displayName%",
  "description": "%description%",
  "l10n": "./l10n",
  "version": "0.4.1",
  "publisher": "tianyu-liu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tianyu-liu/vscode-openrouter-copilot-request-credit.git"
  },
  "bugs": {
    "url": "https://github.com/tianyu-liu/vscode-openrouter-copilot-request-credit/issues"
  },
  "engines": {
    "vscode": "^1.134.0"
  },
  "enabledApiProposals": [
    "chatProvider",
    "languageModelThinkingPart"
  ],
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "openrouter",
    "copilot",
    "byok",
    "request-builder",
    "credit"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "openrouter-copilot-request-credit",
        "displayName": "OpenRouter: RC",
        "managementCommand": "openrouterCopilot.manage"
      }
    ],
    "commands": [
      {
        "command": "openrouterCopilot.manage",
        "title": "%command.manage.title%"
      },
      {
        "command": "openrouterCopilot.pasteTemplate",
        "title": "%command.pasteTemplate.title%"
      },
      {
        "command": "openrouterCopilot.clearTemplate",
        "title": "%command.clearTemplate.title%"
      }
    ],
    "configuration": [
      {
        "title": "%config.title%",
        "properties": {
          "openrouterCopilot.creditLimit": {
            "type": "number",
            "default": 0,
            "minimum": 0,
            "scope": "application",
            "description": "%config.creditLimit.description%"
          },
          "openrouterCopilot.creditResetPeriod": {
            "type": "string",
            "enum": [
              "daily",
              "weekly",
              "monthly",
              "never"
            ],
            "default": "daily",
            "scope": "application",
            "description": "%config.creditResetPeriod.description%"
          },
          "openrouterCopilot.creditIncludeByok": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "description": "%config.creditIncludeByok.description%"
          },
          "openrouterCopilot.creditRefreshIntervalMinutes": {
            "type": "number",
            "default": 5,
            "minimum": 1,
            "maximum": 1440,
            "scope": "application",
            "description": "%config.creditRefreshIntervalMinutes.description%"
          },
          "openrouterCopilot.sanitizeBase64Content": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "description": "%config.sanitizeBase64Content.description%"
          },
          "openrouterCopilot.hideUnavailableModels": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "description": "%config.hideUnavailableModels.description%"
          },
          "openrouterCopilot.outputReservePercent": {
            "type": "number",
            "default": 12.5,
            "minimum": 1,
            "maximum": 50,
            "scope": "application",
            "description": "%config.outputReservePercent.description%"
          },
          "openrouterCopilot.outputReserveMinTokens": {
            "type": "number",
            "default": 16384,
            "minimum": 1,
            "scope": "application",
            "description": "%config.outputReserveMinTokens.description%"
          },
          "openrouterCopilot.outputReserveMaxTokens": {
            "type": "number",
            "default": 262144,
            "minimum": 1,
            "scope": "application",
            "description": "%config.outputReserveMaxTokens.description%"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "preview": "npm run compile && node scripts/panel-preview.mjs",
    "preview:serve": "node scripts/panel-preview.mjs",
    "package": "vsce package --no-dependencies",
    "test": "npm run compile && node out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.134.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.0",
    "mocha": "^10.4.0",
    "typescript": "^5.5.0"
  }
}
